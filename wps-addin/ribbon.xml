<?xml version="1.0" encoding="utf-8"?>
<customUI>
  <ribbon startFromScratch="false">
    <tabs>
      <tab id="gridReportTab" label="涉网试验">
        <group id="gridReportWorkflow" label="报告工作流">
          <button id="grImport" label="导入项目" onAction="onImportProject" imageMso="FileOpen" />
          <button id="grScan" label="扫描资料" onAction="onScanFiles" imageMso="Find" />
          <button id="grData" label="数据中心" onAction="onDataCenter" imageMso="DatabaseTools" />
          <button id="grFields" label="模板字段" onAction="onTemplateFields" imageMso="ReviewCommentNew" />
          <button id="grMatch" label="自动匹配" onAction="onAutoMatch" imageMso="RefreshAll" />
        </group>
        <group id="gridReportOutput" label="报告输出">
          <button id="grCheck" label="报告校核" onAction="onPreflight" imageMso="ReviewTrackingChanges" />
          <button id="grGenerate" label="生成报告" onAction="onGenerate" imageMso="FileSaveAs" />
          <button id="grOutput" label="打开输出目录" onAction="onOutput" imageMso="Folder" />
          <button id="grSettings" label="设置" onAction="onSettings" imageMso="FileProperties" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
